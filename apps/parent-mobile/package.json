{
  "name": "parent-mobile",
  "version": "1.0.5",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "doctor": "npx expo-doctor",
    "build:android:internal": "node ../scripts/mobile-build-guard.mjs parent internal android",
    "build:android:internal-live": "node ../scripts/mobile-build-guard.mjs parent internal-live android",
    "build:android:store-test": "node ../scripts/mobile-build-guard.mjs parent store-test android",
    "build:android:store-live": "node ../scripts/mobile-build-guard.mjs parent store-live android",
    "build:ios:store-test": "node ../scripts/mobile-build-guard.mjs parent store-test ios",
    "build:ios:store-live": "node ../scripts/mobile-build-guard.mjs parent store-live ios",
    "export:web": "expo export --platform web --output-dir dist-web-check",
    "submit:android:store-test": "node ../scripts/mobile-submit-guard.mjs parent android",
    "submit:android:store-live": "node ../scripts/mobile-submit-guard.mjs parent android store-live",
    "submit:ios:store-test": "node ../scripts/mobile-submit-guard.mjs parent ios",
    "submit:ios:store-live": "node ../scripts/mobile-submit-guard.mjs parent ios store-live"
  },
  "dependencies": {
    "@noble/ciphers": "2.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@supabase/supabase-js": "2.102.1",
    "expo": "~54.0.36",
    "expo-application": "~7.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "15.0.9",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-intent-launcher": "~13.0.8",
    "expo-local-authentication": "~17.0.8",
    "expo-notifications": "~0.32.16",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.18",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0"
  },
  "overrides": {
    "shell-quote": "1.10.0"
  }
}
